# Copiar a .env. EXPO_PUBLIC_* es visible en la app; no incluir secretos.
#
# API compartida para probar la app sin levantar Docker localmente.
# Para volver a usar una API local, reemplazá esta URL por la URL accesible
# desde el dispositivo (por ejemplo, la IP LAN de la PC con Docker).
EXPO_PUBLIC_API_URL=https://api-reservas-deportivas-crsl.onrender.com

# Mapas: Leaflet local + teselas OpenStreetMap por HTTPS; no requieren API Key.
