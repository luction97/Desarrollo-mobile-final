# Copiar a .env. EXPO_PUBLIC_* es visible en la app; no incluir secretos.
# Desarrollo: usar la dirección accesible desde el dispositivo o emulador.
# Producción: usar la URL HTTPS del servicio publicado.
EXPO_PUBLIC_API_URL=http://localhost:3000

# APK preview: la URL LAN se configura en build.preview.env de eas.json.
# Cambiarla requiere un nuevo bundle; no es una URL configurable desde la app.
# Opcional hasta completar mapas: restringir por paquete Android y certificado SHA-1.
# Para EAS, definir esta variable en el entorno preview; no versionar claves reales.
GOOGLE_MAPS_ANDROID_API_KEY=
